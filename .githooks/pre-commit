#!/bin/bash
# Reject commits containing hardcoded user/home paths in public repo
# Also catches PII patterns (company names, personal names from CLAUDE.md)

PATTERNS='C:\\Users\\|C:/Users/|/c/Users/|/home/[a-z]|/Users/[A-Z]|%USERPROFILE%|%HOMEPATH%|%APPDATA%|\\マイドライブ|H:/マイドライブ'

# Exclude this hook file itself and go.sum
DIFF=$(git diff --cached --diff-filter=ACMR -- ':!.githooks/*' ':!go.sum' ':!go.mod')

if echo "$DIFF" | grep -qE "$PATTERNS"; then
    echo "ERROR: Staged changes contain hardcoded paths or PII."
    echo ""
    echo "Detected patterns:"
    echo "$DIFF" | grep -n -E "$PATTERNS" | head -15
    echo ""
    echo "Replace with dynamic resolution (os.UserHomeDir, runtime.Caller, os.Getenv, etc.)"
    exit 1
fi
